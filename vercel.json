{
  "git": {
    "deploymentEnabled": true
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node"
    }
  },
  "crons": [
    {
      "path": "/api/reminders/process",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/send-reminders?secret=spielzeitapp-cron-2026",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/calendar/team/(.*)\\.ics",
      "destination": "/api/calendar/team?teamId=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
