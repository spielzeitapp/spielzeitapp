{
  "git": {
    "deploymentEnabled": true
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/vereinsmarkt-manager/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/demo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manager",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manager/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest-trainer.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest-demo.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest-manager.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manager-install.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/landingpage/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app-preview",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/usc.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/clubs/usc-rohrbach/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/vereinszentrale/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/marktplatz/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/turnier-app/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vereinsmarkt-manager",
      "destination": "/vereinsmarkt-manager.html"
    },
    {
      "source": "/vereinsmarkt-manager/anmelden",
      "destination": "/vereinsmarkt-manager.html"
    },
    {
      "source": "/vereinsmarkt-manager/passwort-vergessen",
      "destination": "/vereinsmarkt-manager.html"
    },
    {
      "source": "/vereinsmarkt-manager/:clubId([0-9a-fA-F-]{36})",
      "destination": "/vereinsmarkt-manager.html"
    },
    {
      "source": "/vereinsmarkt-manager/:clubId([0-9a-fA-F-]{36})/:screen(anmelden|passwort-vergessen)",
      "destination": "/vereinsmarkt-manager.html"
    },
    {
      "source": "/vereinsmarkt/3db6fce2-a4c1-44a5-a333-19d1d4d62e6a",
      "destination": "/markt.html"
    },
    {
      "source": "/vereinszentrale",
      "destination": "/vereinszentrale.html"
    },
    {
      "source": "/vereinszentrale/(.*)",
      "destination": "/vereinszentrale.html"
    },
    {
      "source": "/app/usc-rohrbach",
      "destination": "/usc.html"
    },
    {
      "source": "/app/usc-rohrbach/(.*)",
      "destination": "/usc.html"
    },
    {
      "source": "/manager",
      "destination": "/manager.html"
    },
    {
      "source": "/manager/(.*)",
      "destination": "/manager.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/demo/(.*)",
      "destination": "/demo.html"
    },
    {
      "source": "/landingpage",
      "destination": "/landingpage.html"
    },
    {
      "source": "/landingpage/",
      "destination": "/landingpage.html"
    },
    {
      "source": "/landingpage/index.html",
      "destination": "/landingpage.html"
    },
    {
      "source": "/landingpage/impressum.html",
      "destination": "/landingpage-impressum.html"
    },
    {
      "source": "/landingpage/datenschutz.html",
      "destination": "/landingpage-datenschutz.html"
    },
    {
      "source": "/landingpage/:path*",
      "destination": "https://spielzeitapp-fussball.jbharmonikas.chatgpt.site/:path*"
    },
    {
      "source": "/app-preview",
      "destination": "/preview.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/demo/(.*)",
      "destination": "/demo.html"
    },
    {
      "source": "/landingpage",
      "destination": "/landingpage.html"
    },
    {
      "source": "/landingpage/",
      "destination": "/landingpage.html"
    },
    {
      "source": "/landingpage/index.html",
      "destination": "/landingpage.html"
    },
    {
      "source": "/landingpage/impressum.html",
      "destination": "/landingpage-impressum.html"
    },
    {
      "source": "/landingpage/datenschutz.html",
      "destination": "/landingpage-datenschutz.html"
    },
    {
      "source": "/landingpage/:path*",
      "destination": "https://spielzeitapp-fussball.jbharmonikas.chatgpt.site/:path*"
    },
    {
      "source": "/api/calendar/team/(.*)\\.ics",
      "destination": "/api/calendar/team?teamId=$1"
    },
    {
      "source": "/api/push/subscribe",
      "destination": "/api/push/router?pushAction=subscribe"
    },
    {
      "source": "/api/push/unsubscribe",
      "destination": "/api/push/router?pushAction=unsubscribe"
    },
    {
      "source": "/api/push/send-team",
      "destination": "/api/push/router?pushAction=send-team"
    },
    {
      "source": "/api/push/test",
      "destination": "/api/push/router?pushAction=test"
    },
    {
      "source": "/api/account/delete",
      "destination": "/api/exchange/push?accountAction=delete"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/manager",
      "destination": "/manager.html"
    },
    {
      "source": "/manager/(.*)",
      "destination": "/manager.html"
    },
    {
      "source": "/turnier-app",
      "destination": "/turniere.html"
    },
    {
      "source": "/turnier-app/",
      "destination": "/turniere.html"
    },
    {
      "source": "/turnier-app/:publicId",
      "destination": "/turniere.html"
    },
    {
      "source": "/vereinsmarkt/9c7a8741-6e73-42d5-88d8-46ce5217e8cd",
      "destination": "/markt.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/marktplatz/:path*",
      "destination": "/vereinsmarkt/:path*",
      "permanent": true
    }
  ]
}
