{
  "git": {
    "deploymentEnabled": true
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/calendar/team/(.*)\\.ics",
      "destination": "/api/calendar/team?teamId=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
