# =============================================================================
# SpielzeitApp – Umgebungsvariablen (Vorlage)
# Kopie als `.env` anlegen und Werte eintragen. Keine echten Secrets committen.
# =============================================================================

# --- Supabase (Client / Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Web Push: Client (Vite, wird ins Frontend-Bundle eingebettet) ---
# Öffentlicher VAPID-Key. Muss exakt mit VAPID_PUBLIC_KEY (Server) übereinstimmen.
# Erzeugen: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# --- Web Push & API: nur Server (Vercel / lokale API-Routen unter /api) ---
# Niemals mit VITE_-Prefix – diese Werte dürfen nicht im Client-Bundle landen.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com

# Hinweis lokale Entwicklung:
# - SUPABASE_URL kann gleich VITE_SUPABASE_URL sein.
# - VAPID_PUBLIC_KEY = gleicher Wert wie VITE_VAPID_PUBLIC_KEY.
# - Für Push-Subscribe/-Send lokal: `vercel dev` oder Deploy mit gesetzten Server-Variablen.

# --- Reminder-Dispatch POST /api/notifications/dispatch (Cron / Vercel) ---
# CRON_SECRET=
# Optional:
# NOTIFICATION_TRAINING_REMINDER_HOUR=11
# NOTIFICATION_TRAINING_WINDOW_END_HOUR=12
# NOTIFICATION_GAME_REMINDER_DAYS=7

# --- Profil: Push-Sektion optional deaktivieren ---
# VITE_DISABLE_PROFILE_PUSH=true

# Admin Setup: Code wird in der Edge Function "setup-admin" geprüft (Secret ADMIN_SETUP_CODE im Supabase Dashboard).
# VITE_ADMIN_SETUP_CODE wird im Frontend nicht mehr verwendet (Validierung nur noch in der Edge Function).
